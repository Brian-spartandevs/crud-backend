meta {
  name: Create Product
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/api/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Laptop2",
    "description": "High performance laptop",
    "price": 999.99,
    "stock": 10
  }
}

